{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahgold-mpa-staging",
  "account_id": "8bf2b95b3799fcf1679ff23dd19d2a8d",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/robots.txt",
      "/sitemap.xml",
      "/product/*",
      "/products",
      "/cart",
      "/checkout",
      "/about",
      "/contact",
      "/admin",
      "/category/*"
    ],
    "not_found_handling": "404-page"
  }
}
