{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahgold-mpa-staging",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/product/*", "/products", "/cart", "/checkout", "/about", "/contact", "/admin", "/category/*"]
  }
}